# Secrets and machine-specific configuration
.env
.env.*
!.env.example

# Avoid committing large local debugging results
coverage.xml
.coverage
htmlcov/

# Local-only project management / verification notes (retain locally)
/PROJECT_SPEC.md
/PROJECT_STATUS.md
/FILE_STRUCTURE.md
/VALIDATION.txt

# Internal preparation guides / personal notes (not for public repository)
/docs/GITHUB_DESKTOP_STEPS.md
/docs/PUBLISH_CHECKLIST.md
