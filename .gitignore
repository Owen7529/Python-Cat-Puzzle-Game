# Python bytecode/cache
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE/system
.idea/
.vscode/
.DS_Store
Thumbs.db

